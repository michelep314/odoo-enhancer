{
  "manifest_version": 3,
  "name": "Odello",
  "version": "1.18",
  "description": "Nuove funzionalita' per personalizzare odoo",
  "content_scripts": [
    {
      "matches": ["https://*.odoo.com/web*"],
      "css": ["styles.css"],
      "js": [
        "src/core.js",
        "src/changelog.js",
        "src/cards.js",
        "src/columns.js",
        "src/background.js",
        "src/search.js",
        "src/backup.js",
        "src/timesheet.js",
        "src/whatsnew.js",
        "src/bar.js",
        "src/quickedit.js",
        "src/main.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
