{
  "manifest_version": 3,
  "name": "Odoo Enhancer",
  "version": "1.13",
  "description": "Nuove funzionalita' per personalizzare odoo",
  "content_scripts": [
    {
      "matches": ["https://*.odoo.com/web*"],
      "css": ["styles.css"],
      "js": [
        "src/core.js",
        "src/cards.js",
        "src/columns.js",
        "src/background.js",
        "src/timesheet.js",
        "src/bar.js",
        "src/quickedit.js",
        "src/main.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
