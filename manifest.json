{
  "manifest_version": 3,
  "name": "Odello",
  "version": "1.24",
  "description": "Nuove funzionalita' per personalizzare odoo",
  "content_scripts": [
    {
      "matches": [
        "https://*.odoo.com/web*"
      ],
      "css": [
        "styles.css"
      ],
      "js": [
        "src/core.js",
        "src/changelog.js",
        "src/cards.js",
        "src/columns.js",
        "src/background.js",
        "src/search.js",
        "src/backup.js",
        "src/timesheet.js",
        "src/notes.js",
        "src/watch.js",
        "src/whatsnew.js",
        "src/bar.js",
        "src/quickedit.js",
        "src/main.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.odoo.com/web*"
      ],
      "js": [
        "src/bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "src/sw.js"
  },
  "host_permissions": [
    "https://chat.googleapis.com/*"
  ]
}
